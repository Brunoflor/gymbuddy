# Local stack (after `supabase start`, copy the values from `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Hosted projects that use the newer API key name can set this instead of
# NEXT_PUBLIC_SUPABASE_ANON_KEY. The app accepts either one.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shows the local demo accounts on the sign-in screen. Leave unset in production.
NEXT_PUBLIC_DEMO_HINTS=true
